rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 自分の設定（users/自分のuid）だけ読み書きできる
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 自分の練習ノート（users/自分のuid/notes/...）だけ読み書きできる
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
